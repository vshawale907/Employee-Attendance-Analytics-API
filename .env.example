# Copy this file to .env and fill in real values.
# Real environment variables always override .env values.

# MongoDB connection URI - local Docker default shown here.
# For Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# Database name used by the app.
# Development: attendance_db
# Testing / generated data: attendance_test
MONGO_DB=attendance_db
